<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- Night Terror -->
    <ThoughtDef>
        <defName>ExperiencedNightTerror</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>night terror</label>
                <description>That dream felt real. I can still feel the terror clinging to me.</description>
                <baseMoodEffect>-20</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Nightmare -->
    <ThoughtDef>
        <defName>ExperiencedNightmare</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>nightmare</label>
                <description>What an awful dream. I can't shake the unease.</description>
                <baseMoodEffect>-12</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Mid Dream -->
    <ThoughtDef>
        <defName>ExperiencedMidDream</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>strange dream</label>
                <description>That was an odd dream. Not good or bad, just strange.</description>
                <baseMoodEffect>6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Epic Dream -->
    <ThoughtDef>
        <defName>ExperiencedEpicDream</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>epic dream</label>
                <description>What a dream! I woke up full of wonder.</description>
                <baseMoodEffect>12</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Inspirational Dream -->
    <ThoughtDef>
        <defName>ExperiencedInspirationalDream</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>inspirational dream</label>
                <description>That dream showed me possibilities I had never considered.</description>
                <baseMoodEffect>20</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Dream Subject Modifiers -->
    <ThoughtDef>
        <defName>DreamAboutFriend</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>dreamed about friend</label>
                <description>I had a dream about someone I care about.</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>DreamAboutRival</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>dreamed about rival</label>
                <description>I dreamed about someone I can't stand. Even asleep, I couldn't get away from them.</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Vividness Multipliers are handled in code via DreamPart.GetMoodEffect() -->
</Defs>
