<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ResearchProjectDef>
        <defName>DreamTechnology</defName>
        <label>dream technology</label>
        <description>Learn to build Dream Catchers and collect dream parts from sleeping colonists.</description>
        <baseCost>1000</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>ComplexFurniture</li>
        </prerequisites>
        <researchViewX>6</researchViewX>
        <researchViewY>4</researchViewY>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>AdvancedDreamCrafting</defName>
        <label>advanced dream crafting</label>
        <description>Learn to build Dream Labs, where colonists can combine dream parts into crafted dreams.</description>
        <baseCost>2000</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>DreamTechnology</li>
            <li>Electricity</li>
        </prerequisites>
        <researchViewX>7</researchViewX>
        <researchViewY>4</researchViewY>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>DreamEngineering</defName>
        <label>dream engineering</label>
        <description>Learn to build Dream Pods and send crafted dreams that change faction relations.</description>
        <baseCost>3000</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>AdvancedDreamCrafting</li>
            <li>TransportPod</li>
        </prerequisites>
        <researchViewX>8</researchViewX>
        <researchViewY>4</researchViewY>
    </ResearchProjectDef>
</Defs>
